{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quest.schema.json",
  "title": "Runenote quest",
  "description": "A learning path: learn one thing, prepare on a song's hard bars, perform it, revisit older material.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "steps"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "teaches": {
      "type": "string",
      "description": "The one new thing this quest introduces."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": { "enum": ["learn", "prepare", "song", "revisit", "practice"] },
          "song": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$",
            "description": "pack-id/song-id. The guard restricts built-in quests to the core pack."
          },
          "tier": { "type": "integer", "minimum": 1, "maximum": 4 }
        }
      }
    }
  }
}
